# ============================================================
#  Zinguería Servizing · .htaccess  (Apache / hosting compartido)
#  Subir en la raíz del sitio, junto a index.html
# ============================================================
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

# ---------- 1) https + www (una sola dirección oficial) ----------
<IfModule mod_rewrite.c>
RewriteEngine On
# a https (si hay Cloudflare u otro proxy delante, se respeta X-Forwarded-Proto para no entrar en bucle)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{HTTP_HOST} ^(www\.)?zingueriaservizing\.com\.ar$ [NC]
RewriteRule ^ https://www.zingueriaservizing.com.ar%{REQUEST_URI} [L,R=301]
# sin www -> con www
RewriteCond %{HTTP_HOST} ^zingueriaservizing\.com\.ar$ [NC]
RewriteRule ^ https://www.zingueriaservizing.com.ar%{REQUEST_URI} [L,R=301]
# /index.html -> / (evita direcciones duplicadas)
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [L,R=301,NE]
</IfModule>

# ---------- 2) Direcciones viejas -> nuevas (301 = permanente, Google traspasa el posicionamiento) ----------
<IfModule mod_alias.c>
RedirectMatch 301 ^/tienda-estandar/abrazadera-artistica/?(index\.html)?$ /tienda-zingueria/abrazadera-artistica-para-cano/
